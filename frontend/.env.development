# Vite en el PC (npm run dev) → /api/* se proxifica al backend.
# Con `docker compose` el servicio frontend define VITE_API_PROXY_TARGET=http://nginx (no hace falta tocar esto).
# Vacío: rutas relativas /api (recomendado). No pongas localhost:5173 aquí.
VITE_API_BASE_URL=
# Backend: Docker Nginx o `php artisan serve` en 8080
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
