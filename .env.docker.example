# Docker Compose lee automáticamente un archivo `.env` en la raíz del repo (junto a docker-compose.yml).
# Uso: copia este archivo como `.env` y ajusta solo lo que choque en tu PC o en la VPS.
#
# Ejemplo VPS cuando el puerto 8080 del host ya está ocupado:
#   HBM_NGINX_HOST_PORT=18080
#
# Si corres Vite en el PC (npm run dev) y cambiaste el puerto de Nginx, en frontend/.env.development:
#   VITE_API_PROXY_TARGET=http://127.0.0.1:18080
#
# Dominio público + Nginx del host (HTTP en :80) delante del contenedor Vite — HMR por el mismo host/puerto:
#   VITE_HMR_EXTERNAL_HOST=hbm.dataguaviare.com.co
#   VITE_HMR_CLIENT_PORT=80
#   VITE_HMR_PROTOCOL=ws
# Con HTTPS (certbot) usar: VITE_HMR_CLIENT_PORT=443 y VITE_HMR_PROTOCOL=wss

HBM_MYSQL_HOST_PORT=13306
HBM_NGINX_HOST_PORT=8080
HBM_ADMINER_HOST_PORT=8082
HBM_VITE_HOST_PORT=5173
