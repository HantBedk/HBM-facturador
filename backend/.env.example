APP_NAME=HBM

# Datos del emisor en PDF de factura (opcional; por defecto APP_NAME)
# BILLING_ISSUER_NAME=
# BILLING_ISSUER_NIT=
# BILLING_ISSUER_ADDRESS=
# BILLING_ISSUER_PHONE=
# BILLING_ISSUER_EMAIL=
# BILLING_LOGO_PATH=img/logo.png
# BILLING_FOOTER_MESSAGE=
# BILLING_PAYMENT_TERMS=

# Automatización (corte mensual y recordatorios; requiere cron: php artisan schedule:run)
# AUTOMATION_CUTOFF_DAY=28
# AUTOMATION_CUTOFF_ENABLED=false
# AUTOMATION_CUTOFF_REMINDER_DAYS=3
#
# Borradores automáticos (día configurado, schedule 05:00): una factura borrador por empresa con servicios del periodo sin facturar.
# Si guarda valores en el panel (Admin → Configuración → Facturación automática), esos valores sustituyen a los de abajo.
# AUTOMATION_DRAFT_GENERATION_ENABLED=false
# AUTOMATION_DRAFT_GENERATION_DAY=28   # opcional; si se omite, usa AUTOMATION_CUTOFF_DAY
# AUTOMATION_DRAFT_PERIOD=current      # current = mes en curso, previous = mes calendario anterior
# Opcional: ruta de vistas Blade compiladas (en Docker la imagen usa /tmp/laravel-views vía PHP-FPM + /.dockerenv).
# VIEW_COMPILED_PATH=/tmp/laravel-views

APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Producción: APP_DEBUG=false, APP_ENV=production, LOG_LEVEL=warning
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Bogota

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hbm_facturador
DB_USERNAME=hbm
DB_PASSWORD=hbm_secret

# Respaldo automático (php artisan db:backup; schedule diario 02:00 si está habilitado)
# Requiere mysqldump en PATH o ruta en MYSQLDUMP_PATH (Windows/Linux)
DB_BACKUP_ENABLED=false
# DB_BACKUP_PATH=storage/app/backups
# MYSQLDUMP_PATH=mysqldump
# DB_BACKUP_RETAIN_DAYS=14

# Origen del frontend (CORS). Varios valores separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
